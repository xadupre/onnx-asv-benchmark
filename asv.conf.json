{
    "version": 1,
    "project": "onnx-asv-benchmark",
    "project_url": "https://github.com/xadupre/onnx-asv-benchmark",
    "repo": ".",
    "branches": ["main"],
    "environment_type": "virtualenv",
    "pythons": ["3.12"],
    "matrix": {
        "req": {
            "numpy": ["2.5.3"],
            "onnx": ["1.23.1"],
            "onnxruntime": ["1.30.0"]
        },
        "env": {
            "ONNX_LIGHT_VERSION": ["0.1.29"],
            "ONNX_LIGHT_CPU_VERSION": ["0.1.16"]
        }
    },
    "build_command": [],
    "uninstall_command": [],
    "install_command": [
        "python -m pip install torch transformers==5.15.0 scipy>=1.18.0 ml_dtypes>=0.6.0 onnxruntime-genai==0.15.2",
        "python -m pip install --no-deps \"modelbuilder @ git+https://github.com/xadupre/mbext.git@aadae02d50480298db28716e4769a13b3d82f819\"",
        "python -m pip install https://github.com/xadupre/onnx-light/releases/download/0.1.29/onnx_light-0.1.29-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl",
        "python -m pip install https://github.com/xadupre/onnx-light-cpu/releases/download/0.1.16/onnx_light_cpu-0.1.16-cp312-cp312-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl"
    ],
    "benchmark_dir": "benchmarks",
    "env_dir": ".asv/env",
    "results_dir": ".asv/results",
    "html_dir": ".asv/html"
}
